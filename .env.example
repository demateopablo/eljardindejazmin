# Copiar a .env.local (o `vercel env pull .env.local`). Nunca commitear valores reales.
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
ADMIN_EMAILS=mar@gmail.com,pablo@gmail.com
SESSION_SECRET=cambiar-por-openssl-rand-hex-32
GITHUB_TOKEN=github_pat_xxx
GITHUB_REPO=demateopablo/eljardindejazmin
GITHUB_BRANCH=main

# Feed de Instagram (ver docs/instagram.md)
# Token largo generado en el dashboard de Meta. Solo bootstrap/local: en producción manda Edge Config.
INSTAGRAM_ACCESS_TOKEN=IGAAxxxx
# Los inyecta Vercel al conectar el store Edge Config al proyecto (lectura)
EDGE_CONFIG=https://edge-config.vercel.com/ecfg_xxx?token=xxx
# Para escribir el token renovado (cron)
EDGE_CONFIG_ID=ecfg_xxx
VERCEL_API_TOKEN=xxx
VERCEL_TEAM_ID=team_xxx
# Vercel lo manda en Authorization al invocar /api/cron/instagram-refresh
CRON_SECRET=cambiar-por-openssl-rand-hex-32
